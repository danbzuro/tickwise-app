# Supabase local (ver `supabase status`)
VITE_SUPABASE_URL=http://127.0.0.1:56321
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Secrets de la función scrape. No van al browser: se cargan con
# `supabase secrets set` (remoto) o en el env de `supabase functions serve`.
# Vacías: el scrape usa Google News y el filtro por palabras.
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
